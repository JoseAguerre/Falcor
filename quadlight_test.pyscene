# QuadLight test scene.
# Test scene for the new QuadLight: a textured rectangular area light with its own
# dedicated 2D-CDF importance sampler (see Source/Falcor/Scene/Lights/QuadLight.* and
# Source/Falcor/Rendering/Lights/QuadLightSampler.*). No analytic/environment lighting -
# the room is lit purely by the quad light so its contribution is easy to judge.

# Floor
floorMat = StandardMaterial('Floor')
floorMat.baseColor = float4(0.6, 0.6, 0.6, 1.0)
floorMat.roughness = 0.6
floorMesh = TriangleMesh.createQuad(float2(6.0, 6.0))
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Floor', Transform(translation=float3(0, 0, 0))),
    sceneBuilder.addTriangleMesh(floorMesh, floorMat)
)

# A sphere on the floor to show shadowing/highlights from the quad light.
sphereMat = StandardMaterial('Sphere')
sphereMat.baseColor = float4(0.8, 0.2, 0.2, 1.0)
sphereMat.roughness = 0.3
sphereMesh = TriangleMesh.createSphere(0.6)
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Sphere', Transform(translation=float3(0.8, 0.6, -0.5))),
    sceneBuilder.addTriangleMesh(sphereMesh, sphereMat)
)

# A sharp GGX metal sphere to show specular reflections of the quad light's texture.
metalMat = StandardMaterial('MetalSphere')
metalMat.baseColor = float4(0.9, 0.9, 0.92, 1.0)
metalMat.roughness = 0.05
metalMat.metallic = 1.0
metalSphereMesh = TriangleMesh.createSphere(0.5)
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('MetalSphere', Transform(translation=float3(-1.3, 0.5, -0.3))),
    sceneBuilder.addTriangleMesh(metalSphereMesh, metalMat)
)

# A more complex diffuse object (Stanford bunny) to show shadowing/GI from a non-primitive mesh.
bunnyMat = StandardMaterial('Bunny')
bunnyMat.baseColor = float4(0.75, 0.75, 0.75, 1.0)
bunnyMat.roughness = 0.8
bunnyScale = 4.0
bunnyMesh = TriangleMesh.createFromFile('C:/packman-repo/chk/falcor_media/7acdf8b0/test_scenes/meshes/bunny.obj')
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Bunny', Transform(translation=float3(0.5, -0.033 * bunnyScale, 1.3), scaling=float3(bunnyScale, bunnyScale, bunnyScale))),
    sceneBuilder.addTriangleMesh(bunnyMesh, bunnyMat)
)

# Quad light: a non-emissive placeholder material (kept out of the standard
# emissive-triangle light pipeline on purpose) assigned to a real quad mesh, plus a
# QuadLight object that shares the exact same transform/size and does the actual
# lighting via its own importance sampler.
quadLightMat = StandardMaterial('QuadLightMat')  # emissiveFactor left at 0 - non-emissive on purpose
quadLightMatID = sceneBuilder.addMaterial(quadLightMat)

quadSize = float2(2.0, 1.2)
quadMesh = TriangleMesh.createQuad(quadSize)
# createQuad's default normal is +Y; rotate 180 degrees about X so it faces down into the room.
quadTransform = Transform(translation=float3(0, 3.0, 0), rotationEulerDeg=float3(180, 0, 0))
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('QuadLight', quadTransform),
    sceneBuilder.addTriangleMesh(quadMesh, quadLightMat)  # same quadLightMat instance -> addMaterial dedupes to quadLightMatID
)

quadLight = QuadLight.createFromFile('quadlight/hdr/frame_00048.hdr')
quadLight.materialID = quadLightMatID
quadLight.transform = quadTransform.matrix
quadLight.size = quadSize
quadLight.intensity = 8.0
sceneBuilder.quadLight = quadLight

# Camera
camera = Camera()
camera.position = float3(0, 1.6, 4.0)
camera.target = float3(0, 1.0, 0)
camera.up = float3(0, 1, 0)
camera.focalLength = 21.0
sceneBuilder.addCamera(camera)

# Disable analytic/env lighting so the room is lit purely by the quad light.
sceneBuilder.renderSettings = SceneRenderSettings(useEnvLight=False, useAnalyticLights=False, useEmissiveLights=False, useQuadLight=True)
