# Box-room variant of stilllife_envmap_test.pyscene: same objects and QuadLight side-window,
# but enclosed in a full box room (floor/ceiling/4 walls) instead of just a floor, sized to
# comfortably walk/fly the camera around inside rather than just view from one fixed spot.
#
# Room interior: X in [-4.2, 4.2], Z in [-4.0, 4.0], Y (height) in [0, 4.5]. The QuadLight
# window sits on the -X wall at x=-3.4 (0.8 units proud of the x=-4.2 wall, so it doesn't
# overlap/z-fight with it) - same position/size as stilllife_envmap_test.pyscene, just now
# inside an enclosed room instead of floating past the edge of an open floor.

# Room: floor, ceiling, and 4 walls, all sharing one material. Each wall reuses
# TriangleMesh.createQuad's default (+Y normal, local XZ plane) rotated to face inward -
# every rotation below is single-axis and was verified by hand the same way as
# stilllife_envmap_test.pyscene's QuadLight rotation (just simpler here, since a plain
# diffuse wall has no texture "up" direction to also get right - only the facing direction
# and size matter).
roomMat = StandardMaterial('Room')
roomMat.baseColor = float4(0.7, 0.7, 0.7, 1.0)
roomMat.roughness = 0.7

roomHalfX = 4.2
roomHalfZ = 4.0
roomHeight = 4.5

def addRoomPanel(name, size, transform):
    sceneBuilder.addMeshInstance(
        sceneBuilder.addNode(name, transform),
        sceneBuilder.addTriangleMesh(TriangleMesh.createQuad(size), roomMat)  # same roomMat instance every call -> Falcor dedupes it to one material internally
    )

# Floor: default +Y normal already faces up into the room - no rotation needed.
addRoomPanel('Floor', float2(2.0 * roomHalfX, 2.0 * roomHalfZ), Transform(translation=float3(0, 0, 0)))

# Ceiling: rotate 180 degrees about X to flip the default +Y normal to face down into the room.
addRoomPanel('Ceiling', float2(2.0 * roomHalfX, 2.0 * roomHalfZ), Transform(translation=float3(0, roomHeight, 0), rotationEulerDeg=float3(180, 0, 0)))

# -X wall: rotationEulerDeg=(0,0,-90) sends the default +Y normal to world +X (facing into
# the room) and local X to world Y (so size.x below is the wall's height, size.y its depth).
addRoomPanel('WallNegX', float2(roomHeight, 2.0 * roomHalfZ), Transform(translation=float3(-roomHalfX, roomHeight * 0.5, 0), rotationEulerDeg=float3(0, 0, -90)))

# +X wall: rotationEulerDeg=(0,0,90) sends +Y normal to world -X (facing into the room).
addRoomPanel('WallPosX', float2(roomHeight, 2.0 * roomHalfZ), Transform(translation=float3(roomHalfX, roomHeight * 0.5, 0), rotationEulerDeg=float3(0, 0, 90)))

# -Z wall: rotationEulerDeg=(90,0,0) sends +Y normal to world +Z (facing into the room);
# local X stays world X here, so size.x is width and size.y is height.
addRoomPanel('WallNegZ', float2(2.0 * roomHalfX, roomHeight), Transform(translation=float3(0, roomHeight * 0.5, -roomHalfZ), rotationEulerDeg=float3(90, 0, 0)))

# +Z wall: rotationEulerDeg=(-90,0,0) sends +Y normal to world -Z (facing into the room).
addRoomPanel('WallPosZ', float2(2.0 * roomHalfX, roomHeight), Transform(translation=float3(0, roomHeight * 0.5, roomHalfZ), rotationEulerDeg=float3(-90, 0, 0)))

# A sphere on the floor to show shadowing/highlights from the quad light.
sphereMat = StandardMaterial('Sphere')
sphereMat.baseColor = float4(0.8, 0.2, 0.2, 1.0)
sphereMat.roughness = 0.3
sphereMesh = TriangleMesh.createSphere(0.6)
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Sphere', Transform(translation=float3(0.8, 0.6, -0.5))),
    sceneBuilder.addTriangleMesh(sphereMesh, sphereMat)
)

# A sharp GGX metal sphere to show specular reflections of the quad light's texture.
metalMat = StandardMaterial('MetalSphere')
metalMat.baseColor = float4(0.9, 0.9, 0.92, 1.0)
metalMat.roughness = 0.05
metalMat.metallic = 1.0
metalSphereMesh = TriangleMesh.createSphere(0.5)
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('MetalSphere', Transform(translation=float3(-1.3, 0.5, -0.3))),
    sceneBuilder.addTriangleMesh(metalSphereMesh, metalMat)
)

# A more complex diffuse object (Stanford bunny) to show shadowing/GI from a non-primitive mesh.
bunnyMat = StandardMaterial('Bunny')
bunnyMat.baseColor = float4(0.75, 0.75, 0.75, 1.0)
bunnyMat.roughness = 0.8
bunnyScale = 4.0
bunnyMesh = TriangleMesh.createFromFile('C:/packman-repo/chk/falcor_media/7acdf8b0/test_scenes/meshes/bunny.obj')
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Bunny', Transform(translation=float3(0.5, -0.033 * bunnyScale, 1.3), scaling=float3(bunnyScale, bunnyScale, bunnyScale))),
    sceneBuilder.addTriangleMesh(bunnyMesh, bunnyMat)
)

# Quad light: same big vertical "window" on the -X side of the room as
# stilllife_envmap_test.pyscene, facing +X (into the room) - see that file for the full
# derivation of why this specific rotation is needed (a single axis isn't enough here,
# since the texture's "up" direction also has to line up with world up, unlike the plain
# room walls above).
quadLightMat = StandardMaterial('QuadLightMat')  # emissiveFactor left at 0 - non-emissive on purpose
quadLightMatID = sceneBuilder.addMaterial(quadLightMat)

quadSize = float2(4.5, 3.5)  # width-along-Z, height
quadTransform = Transform(translation=float3(-3.4, 1.9, 0.3), rotationEulerDeg=float3(0, -90, -90))
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('QuadLight', quadTransform),
    sceneBuilder.addTriangleMesh(TriangleMesh.createQuad(quadSize), quadLightMat)  # same quadLightMat instance -> addMaterial dedupes to quadLightMatID
)

quadLight = QuadLight.createFromFile('C:/Users/Elojo/Downloads/vp9macroblock/vp9macroblock-viewer/encoded/frames/frame_00048.exr')
quadLight.materialID = quadLightMatID
quadLight.transform = quadTransform.matrix
quadLight.size = quadSize
quadLight.intensity = 1.5  # starting point - adjust live via the UI's Intensity slider.
sceneBuilder.quadLight = quadLight

# Camera - pulled in from stilllife_envmap_test.pyscene's fixed framing to sit safely inside
# the now-enclosed room (that scene's z=4.0 would sit right at this room's +Z wall) so there's
# room to fly around without immediately clipping through it.
camera = Camera()
camera.position = float3(0, 1.6, 2.8)
camera.target = float3(0, 1.0, 0)
camera.up = float3(0, 1, 0)
camera.focalLength = 21.0
sceneBuilder.addCamera(camera)

# Disable analytic/env lighting so the room is lit purely by the quad light.
sceneBuilder.renderSettings = SceneRenderSettings(useEnvLight=False, useAnalyticLights=False, useEmissiveLights=False, useQuadLight=True)
