\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces RMSE against the converged reference, divided by the RMSE of $B=4000$ at the same number of light samples per pixel (spp), as a function of the leaf budget $B$. Each curve is one spp; Cinema's values are in the legend, and the other scenes use the same color order from their lowest to their highest spp. Values above 1 mean more error than $B=4000$.}}{1}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:quality}{{1}{1}{RMSE against the converged reference, divided by the RMSE of $B=4000$ at the same number of light samples per pixel (spp), as a function of the leaf budget $B$. Each curve is one spp; Cinema's values are in the legend, and the other scenes use the same color order from their lowest to their highest spp. Values above 1 mean more error than $B=4000$}{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces GPU time of light sampling alone, without ray tracing or shading, for one $1920\times 1080$ frame at 128 light samples per pixel, in milliseconds (median of three runs), and size of each sampling structure. Rover, Cinema and Phone have 1080p emitters; Fireplace and Convergence have 4K emitters.}}{2}{table.caption.5}\protected@file@percent }
\newlabel{tab:sampling}{{1}{2}{GPU time of light sampling alone, without ray tracing or shading, for one $1920\times 1080$ frame at 128 light samples per pixel, in milliseconds (median of three runs), and size of each sampling structure. Rover, Cinema and Phone have 1080p emitters; Fireplace and Convergence have 4K emitters}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: latency of dependent random reads against the size of the data being read, on the GPU (pointer chase, aggregate over the whole GPU). Right: measured cost of one light sample against the size of the sampling structure: BudgetLeafAlias from 64 to 16000 leaves (lines), and the 2D CDF, per-pixel alias and a 2D CDF built at one eighth of the resolution (markers), in Rover (1080p, blue) and Convergence (4K, purple). Shaded: the first-level cache limit, 128--192\,KB.}}{3}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cache}{{2}{3}{Left: latency of dependent random reads against the size of the data being read, on the GPU (pointer chase, aggregate over the whole GPU). Right: measured cost of one light sample against the size of the sampling structure: BudgetLeafAlias from 64 to 16000 leaves (lines), and the 2D CDF, per-pixel alias and a 2D CDF built at one eighth of the resolution (markers), in Rover (1080p, blue) and Convergence (4K, purple). Shaded: the first-level cache limit, 128--192\,KB}{figure.caption.7}{}}
