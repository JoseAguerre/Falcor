# ---------------------------------------------------------------------------
# l-corner-area-light.pyscene
#
# Falcor equivalent of the Three.js "area light convergence" demo:
# two 2x2 squares in an L, one fully emissive (area light), one fully
# diffuse, lit only by that light. Falcor's path tracer imports emissive
# triangles as light sources automatically and importance-samples them
# per bounce, so no separate AnalyticLight is needed -- this mirrors the
# demo's own "sample the light directly" approach, and Falcor's built-in
# low-discrepancy sample generator plays the same role as the QMC (R2 +
# Cranley-Patterson) scheme used in the WebGL shader.
#
# Geometry / values below match the Three.js demo's current defaults:
#   SQUARE      = 2.0   (both squares are 2x2 units)
#   albedo      = 0.85
#   intensity   = 8.0
#   lightSize   = 0.35  -> visible/sampled light square is 0.7 x 0.7
#   floor:  normal +Y, centered at (0,0,0), z in [-1,1]
#   light:  normal +Z, centered at (0,1,-1), standing vertically
#   camera: position (3.2, 2.1, 3.4), target (0, 0.8, 0.2)
#
# Caveats (things that don't have a 1:1 pyscene equivalent):
#   - The "disable distance attenuation" checkbox is a non-physical hack
#     specific to the custom shader; Falcor's path tracer always uses
#     correct 1/r^2 falloff, there's no toggle for that here.
#   - StandardMaterial is a metallic-roughness BSDF, not a pure Lambertian
#     BRDF. roughness=1, metallic=0 gets close to "completely diffuse"
#     but isn't bit-exact Lambertian the way the demo's shader is.
# ---------------------------------------------------------------------------

# ---- materials ----

diffuse = StandardMaterial('Diffuse')
diffuse.baseColor = float4(0.85, 0.85, 0.85, 1.0)
diffuse.roughness = 1.0
diffuse.metallic = 0.0
diffuse.doubleSided = True

light = StandardMaterial('Light')
light.baseColor = float4(1.0, 1.0, 1.0, 1.0)
light.roughness = 1.0
light.metallic = 0.0
light.emissiveColor = float3(1.0, 1.0, 1.0)
light.emissiveFactor = 8.0          # == uIntensity default in the shader
light.doubleSided = True

# ---- geometry ----
# TriangleMesh.createQuad() is a unit (1x1) quad in the XY plane with
# normal +Z by default; Transform.scaling brings it up to the demo's
# 2x2 SQUARE size.
#
# NOTE: each mesh instance gets its OWN TriangleMesh object. addTriangleMesh()
# appears to consume/move the mesh data on registration, so reusing a single
# TriangleMesh across two addTriangleMesh() calls silently registers an empty
# mesh the second time -- which is almost certainly why only one square was
# showing up.

floorMeshID = sceneBuilder.addTriangleMesh(TriangleMesh.createQuad(), diffuse)
lightMeshID = sceneBuilder.addTriangleMesh(TriangleMesh.createQuad(), light)

# Floor: rotate -90 deg about X so the +Z normal becomes +Y (facing up),
# scale to the 2x2 SQUARE, sits at the origin -- matches floorGeo in the
# Three.js scene (PlaneGeometry rotated -90 deg about X).
floorNodeID = sceneBuilder.addNode(
    'Floor',
    Transform(scaling=2.0, translation=float3(0, 0, 0), rotationEulerDeg=float3(-90, 0, 0))
)

# Light: no rotation needed, default +Z normal already faces the room.
# Scale = SQUARE(2.0) * lightSize(0.35) = 0.7, matching lightMesh.scale
# in the Three.js demo.
lightNodeID = sceneBuilder.addNode(
    'Light',
    Transform(scaling=0.7, translation=float3(0, 1, -1))
)

sceneBuilder.addMeshInstance(floorNodeID, floorMeshID)
sceneBuilder.addMeshInstance(lightNodeID, lightMeshID)

# ---- camera ----
# focalLength derived from the Three.js PerspectiveCamera's 45 deg
# vertical FOV against Falcor's default 24mm sensor height:
#   focalLength = (frameHeight/2) / tan(fov/2) = 12 / tan(22.5 deg) ~= 29mm

camera = Camera('Camera')
camera.position = float3(3.2, 2.1, 3.4)
camera.target = float3(0.0, 0.8, 0.2)
camera.up = float3(0.0, 1.0, 0.0)
camera.focalLength = 29.0
sceneBuilder.addCamera(camera)
sceneBuilder.selectedCamera = camera
