_skipped = []
for i, (filename, mat_id) in enumerate(_SHAPES):
    mesh = TriangleMesh.createFromFile('meshes/' + filename)
    if mesh is None:
        # A handful of the source .ply files are corrupted (Assimp reports e.g. "Broken face
        # data" - same header/size as their siblings, so this looks like genuine bit damage in
        # that specific file rather than a format issue). Skip gracefully rather than aborting
        # the whole scene load; see the printed summary below for exactly which ones.
        _skipped.append(filename)
        continue
    sceneBuilder.addMeshInstance(
        sceneBuilder.addNode('{}_{}'.format(filename, i), Transform()),
        sceneBuilder.addTriangleMesh(mesh, materials[mat_id])
    )

if _skipped:
    print('rover.pyscene: skipped {} mesh(es) that failed to load (corrupted source .ply):'.format(len(_skipped)))
    for f in _skipped:
        print('  - ' + f)
