# StillLife.exr envmap test scene.
# Same geometry as quadlight_test.pyscene, but lit by StillLife.exr as an environment map
# (using Falcor's existing EnvMapSampler, mip-hierarchical importance sampling) instead of
# a QuadLight. No quad light is added. Used to isolate whether fireflies seen with
# StillLife.exr as a QuadLight texture are specific to the new QuadLightSampler code or
# are inherent to importance-sampling this particular (sharp, high-dynamic-range) image -
# if EnvMap shows the same kind of fireflies with the same file, that points at shared/
# inherent behavior rather than a QuadLight-specific bug.

# Floor
floorMat = StandardMaterial('Floor')
floorMat.baseColor = float4(0.6, 0.6, 0.6, 1.0)
floorMat.roughness = 0.6
floorMesh = TriangleMesh.createQuad(float2(6.0, 6.0))
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Floor', Transform(translation=float3(0, 0, 0))),
    sceneBuilder.addTriangleMesh(floorMesh, floorMat)
)

# A sphere on the floor to show shadowing/highlights from the envmap.
sphereMat = StandardMaterial('Sphere')
sphereMat.baseColor = float4(0.8, 0.2, 0.2, 1.0)
sphereMat.roughness = 0.3
sphereMesh = TriangleMesh.createSphere(0.6)
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Sphere', Transform(translation=float3(0.8, 0.6, -0.5))),
    sceneBuilder.addTriangleMesh(sphereMesh, sphereMat)
)

# A sharp GGX metal sphere to show specular reflections of the envmap.
metalMat = StandardMaterial('MetalSphere')
metalMat.baseColor = float4(0.9, 0.9, 0.92, 1.0)
metalMat.roughness = 0.05
metalMat.metallic = 1.0
metalSphereMesh = TriangleMesh.createSphere(0.5)
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('MetalSphere', Transform(translation=float3(-1.3, 0.5, -0.3))),
    sceneBuilder.addTriangleMesh(metalSphereMesh, metalMat)
)

# A more complex diffuse object (Stanford bunny) to show shadowing/GI from a non-primitive mesh.
bunnyMat = StandardMaterial('Bunny')
bunnyMat.baseColor = float4(0.75, 0.75, 0.75, 1.0)
bunnyMat.roughness = 0.8
bunnyScale = 4.0
bunnyMesh = TriangleMesh.createFromFile('C:/packman-repo/chk/falcor_media/7acdf8b0/test_scenes/meshes/bunny.obj')
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Bunny', Transform(translation=float3(0.5, -0.033 * bunnyScale, 1.3), scaling=float3(bunnyScale, bunnyScale, bunnyScale))),
    sceneBuilder.addTriangleMesh(bunnyMesh, bunnyMat)
)

# Environment map: frame_00048.exr (temporarily swapped in to isolate whether the crash
# seen loading this file into a QuadLight is in Texture::createFromFile's shared GPU
# texture-load/mip-generation path - EnvMap.createFromFile() calls that exact same
# function with the same arguments - or is specific to QuadLight's own loading code).
envMap = EnvMap.createFromFile('C:/Users/Elojo/Downloads/vp9macroblock/vp9macroblock-viewer/encoded/frames/frame_00048.exr')
envMap.intensity = 1.0
sceneBuilder.envMap = envMap

# Camera - same framing as quadlight_test.pyscene.
camera = Camera()
camera.position = float3(0, 1.6, 4.0)
camera.target = float3(0, 1.0, 0)
camera.up = float3(0, 1, 0)
camera.focalLength = 21.0
sceneBuilder.addCamera(camera)

# Disable analytic/quad lighting so the room is lit purely by the envmap.
sceneBuilder.renderSettings = SceneRenderSettings(useEnvLight=True, useAnalyticLights=False, useEmissiveLights=False, useQuadLight=False)
